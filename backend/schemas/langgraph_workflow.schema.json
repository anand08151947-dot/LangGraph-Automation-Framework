{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LangGraph Agentic Workflow Configuration",
  "type": "object",
  "properties": {
    "graph_name": { "type": "string" },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["stdio", "sse"] },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["type"],
        "oneOf": [
          { "required": ["command", "args"] },
          { "required": ["url"] }
        ]
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "system_prompt": { "type": "string" },
          "tools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "mcp_bindings": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "next": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "required": ["name", "next"]
      }
    }
  },
  "required": ["graph_name", "agents"]
}
