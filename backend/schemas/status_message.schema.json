{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebSocket Status Message",
  "type": "object",
  "properties": {
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["unknown", "running", "completed", "error"] },
    "result": {},
    "error": { "type": "string" },
    "timestamp": { "type": "number" }
  },
  "required": ["run_id", "status"],
  "additionalProperties": true
}
