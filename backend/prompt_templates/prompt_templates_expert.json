[
  {
    "use_case": "Incident Response Workflow",
    "description": "Automated incident detection, triage, escalation, and resolution with multiple agents.",
    "sample_prompt": "Create a workflow where a Detector identifies incidents, a TriageAgent assesses severity, an Escalator notifies stakeholders if critical, and a Resolver fixes the issue.",
    "template_json": {
      "graph_name": "Incident_Response_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "Detector",
          "type": "agent",
          "system_prompt": "Detect incidents from monitoring data.",
          "tools": [
            "monitoring_api"
          ],
          "next": "TriageAgent"
        },
        {
          "id": "TriageAgent",
          "type": "agent",
          "system_prompt": "Assess incident severity. If critical, escalate; else, resolve.",
          "next": "Escalator"
        },
        {
          "id": "Escalator",
          "type": "agent",
          "system_prompt": "Notify stakeholders for critical incidents.",
          "tools": [
            "email_api"
          ],
          "next": "Resolver"
        },
        {
          "id": "Resolver",
          "type": "agent",
          "system_prompt": "Resolve the incident and close the workflow.",
          "tools": [
            "remediation_tool"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "Detector",
          "to": "TriageAgent"
        },
        {
          "from": "TriageAgent",
          "to": "Escalator"
        },
        {
          "from": "Escalator",
          "to": "Resolver"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
