[
  {
    "use_case": "Insurance Claim Processing",
    "description": "Automated workflow for insurance claim intake, assessment, approval, and payout.",
    "sample_prompt": "Create a workflow where a ClaimIntakeAgent collects claim details, an Assessor evaluates the claim, an Approver authorizes payout, and a PayoutAgent processes payment.",
    "template_json": {
      "graph_name": "Insurance_Claim_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "ClaimIntakeAgent",
          "type": "agent",
          "system_prompt": "Collect insurance claim details from customer.",
          "tools": [
            "claim_api"
          ],
          "next": "Assessor"
        },
        {
          "id": "Assessor",
          "type": "agent",
          "system_prompt": "Evaluate claim validity and required documentation.",
          "tools": [
            "assessment_tool"
          ],
          "next": "Approver"
        },
        {
          "id": "Approver",
          "type": "agent",
          "system_prompt": "Authorize claim payout if approved.",
          "next": "PayoutAgent"
        },
        {
          "id": "PayoutAgent",
          "type": "agent",
          "system_prompt": "Process payment to customer and close claim.",
          "tools": [
            "payment_api"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "ClaimIntakeAgent",
          "to": "Assessor"
        },
        {
          "from": "Assessor",
          "to": "Approver"
        },
        {
          "from": "Approver",
          "to": "PayoutAgent"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
