[
  {
    "use_case": "Hospitality Guest Experience",
    "description": "Automated workflow for guest check-in, concierge service, room service, and feedback collection in hospitality.",
    "sample_prompt": "Create a workflow where a CheckInAgent handles guest arrival, a ConciergeAgent manages requests, a RoomServiceAgent delivers services, and a FeedbackAgent collects guest feedback.",
    "template_json": {
      "graph_name": "Guest_Experience_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "CheckInAgent",
          "type": "agent",
          "system_prompt": "Handle guest check-in and registration.",
          "tools": [
            "checkin_api"
          ],
          "next": "ConciergeAgent"
        },
        {
          "id": "ConciergeAgent",
          "type": "agent",
          "system_prompt": "Manage guest requests and reservations.",
          "tools": [
            "concierge_api"
          ],
          "next": "RoomServiceAgent"
        },
        {
          "id": "RoomServiceAgent",
          "type": "agent",
          "system_prompt": "Deliver room service and amenities.",
          "tools": [
            "room_service_api"
          ],
          "next": "FeedbackAgent"
        },
        {
          "id": "FeedbackAgent",
          "type": "agent",
          "system_prompt": "Collect guest feedback and ratings.",
          "tools": [
            "feedback_api"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "CheckInAgent",
          "to": "ConciergeAgent"
        },
        {
          "from": "ConciergeAgent",
          "to": "RoomServiceAgent"
        },
        {
          "from": "RoomServiceAgent",
          "to": "FeedbackAgent"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
