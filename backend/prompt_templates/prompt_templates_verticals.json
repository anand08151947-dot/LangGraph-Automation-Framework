[
  {
    "use_case": "Media Production Workflow",
    "description": "Automated workflow for video production: scripting, filming, editing, and publishing.",
    "sample_prompt": "Create a workflow where a ScriptWriter drafts the script, a FilmingAgent records footage, an Editor edits the video, and a Publisher releases the final product.",
    "template_json": {
      "graph_name": "Media_Production_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "ScriptWriter",
          "type": "agent",
          "system_prompt": "Draft video script based on requirements.",
          "tools": [
            "script_tool"
          ],
          "next": "FilmingAgent"
        },
        {
          "id": "FilmingAgent",
          "type": "agent",
          "system_prompt": "Record video footage as per script.",
          "tools": [
            "camera_api"
          ],
          "next": "Editor"
        },
        {
          "id": "Editor",
          "type": "agent",
          "system_prompt": "Edit and finalize video content.",
          "tools": [
            "editing_tool"
          ],
          "next": "Publisher"
        },
        {
          "id": "Publisher",
          "type": "agent",
          "system_prompt": "Publish the final video to media platforms.",
          "tools": [
            "media_api"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "ScriptWriter",
          "to": "FilmingAgent"
        },
        {
          "from": "FilmingAgent",
          "to": "Editor"
        },
        {
          "from": "Editor",
          "to": "Publisher"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
