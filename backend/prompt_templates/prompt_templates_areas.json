[
  {
    "use_case": "Nonprofit Grant Application",
    "description": "Automated workflow for grant application, review, approval, and fund disbursement in nonprofit sector.",
    "sample_prompt": "Create a workflow where an Applicant submits a grant request, a Reviewer checks eligibility, an Approver authorizes the grant, and a Disburser releases funds.",
    "template_json": {
      "graph_name": "Grant_Application_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "Applicant",
          "type": "agent",
          "system_prompt": "Submit grant application and supporting documents.",
          "tools": [
            "application_api"
          ],
          "next": "Reviewer"
        },
        {
          "id": "Reviewer",
          "type": "agent",
          "system_prompt": "Review application for eligibility and completeness.",
          "tools": [
            "review_tool"
          ],
          "next": "Approver"
        },
        {
          "id": "Approver",
          "type": "agent",
          "system_prompt": "Authorize grant if approved.",
          "next": "Disburser"
        },
        {
          "id": "Disburser",
          "type": "agent",
          "system_prompt": "Disburse grant funds to applicant.",
          "tools": [
            "funds_api"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "Applicant",
          "to": "Reviewer"
        },
        {
          "from": "Reviewer",
          "to": "Approver"
        },
        {
          "from": "Approver",
          "to": "Disburser"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
