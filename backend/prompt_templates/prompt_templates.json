[
  {
    "use_case": "Supervisor Approval Flow",
    "description": "A supervisor reviews and approves work before passing it to the executor.",
    "sample_prompt": "Create a workflow where an initiator submits a project proposal, SupervisorA reviews and approves it, then SupervisorB gives final approval before the Executor implements the plan. If rejected at any stage, the proposal returns for revision.",
    "template_json": {
      "graph_name": "Supervisor_Approval_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "Initiator",
          "type": "agent",
          "system_prompt": "Start a new project proposal and send to SupervisorA.",
          "next": "SupervisorA"
        },
        {
          "id": "SupervisorA",
          "type": "agent",
          "system_prompt": "Review proposal. If approved, send to SupervisorB; if not, return to Initiator for revision.",
          "next": "SupervisorB"
        },
        {
          "id": "SupervisorB",
          "type": "agent",
          "system_prompt": "Final approval. If approved, send to Executor; if not, return to SupervisorA.",
          "next": "Executor"
        },
        {
          "id": "Executor",
          "type": "agent",
          "system_prompt": "Execute the approved project plan.",
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "Initiator",
          "to": "SupervisorA"
        },
        {
          "from": "SupervisorA",
          "to": "SupervisorB"
        },
        {
          "from": "SupervisorB",
          "to": "Executor"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
  {
    "use_case": "Multi-Agent Cycle",
    "description": "Agents communicate in a cycle until a condition is met, e.g., research and review loop.",
    "sample_prompt": "Create a workflow where a Researcher finds facts, a Reviewer checks the summary, and if incomplete, sends it back to the Researcher. Once approved, a Writer creates a blog post.",
    "template_json": {
      "graph_name": "Agent_Cycle_Review",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "Researcher",
          "type": "agent",
          "system_prompt": "Research the latest AI trends and summarize findings.",
          "tools": [
            "web_search"
          ],
          "next": "Reviewer"
        },
        {
          "id": "Reviewer",
          "type": "agent",
          "system_prompt": "Review the research summary. If incomplete, send back to Researcher; else, forward to Writer.",
          "next": "Researcher"
        },
        {
          "id": "Writer",
          "type": "agent",
          "system_prompt": "Write a blog post based on the reviewed summary.",
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "Researcher",
          "to": "Reviewer"
        },
        {
          "from": "Reviewer",
          "to": "Researcher"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
  {
    "use_case": "Delegator and Aggregator",
    "description": "A delegator splits tasks among workers, then aggregates results for supervisor review.",
    "sample_prompt": "Create a workflow where a Supervisor assigns tasks to a Delegator, who splits work between Worker1 and Worker2. An Aggregator combines their results and sends them back to the Supervisor.",
    "template_json": {
      "graph_name": "Supervisor_Delegator_MultiAgent",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "Supervisor",
          "type": "agent",
          "system_prompt": "Assign tasks to agents based on incoming requests. If a task fails, reassign or escalate.",
          "next": "Delegator"
        },
        {
          "id": "Delegator",
          "type": "agent",
          "system_prompt": "Delegate subtasks to Worker1 and Worker2, aggregate their results.",
          "next": "Aggregator"
        },
        {
          "id": "Worker1",
          "type": "agent",
          "system_prompt": "Handle data extraction tasks.",
          "next": "Aggregator"
        },
        {
          "id": "Worker2",
          "type": "agent",
          "system_prompt": "Handle data analysis tasks.",
          "next": "Aggregator"
        },
        {
          "id": "Aggregator",
          "type": "agent",
          "system_prompt": "Combine results from Worker1 and Worker2, send to Supervisor for review.",
          "next": "Supervisor"
        }
      ],
      "edges": [
        {
          "from": "Supervisor",
          "to": "Delegator"
        },
        {
          "from": "Delegator",
          "to": "Aggregator"
        },
        {
          "from": "Worker1",
          "to": "Aggregator"
        },
        {
          "from": "Worker2",
          "to": "Aggregator"
        },
        {
          "from": "Aggregator",
          "to": "Supervisor"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
  {
    "use_case": "MCP Tool Integration",
    "description": "Agents use MCP servers for external tool access, e.g., GitHub or Slack integration.",
    "sample_prompt": "Create a workflow where RepoManager uses GitHub tools via MCP to manage repositories.",
    "template_json": {
      "graph_name": "Enterprise_Assistant",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "mcp_servers": {
        "github_tools": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-github"
          ]
        },
        "postgres_db": {
          "type": "sse",
          "url": "http://localhost:8080/mcp"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "RepoManager",
          "type": "agent",
          "system_prompt": "Manage GitHub repositories using MCP tools.",
          "tools": [
            "github_tools"
          ],
          "next": "END"
        }
      ],
      "edges": [],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  }
