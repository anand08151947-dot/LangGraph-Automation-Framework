[
  {
    "use_case": "Data Pipeline with Reviewer",
    "description": "A multi-step data pipeline where each stage is reviewed before proceeding.",
    "sample_prompt": "Create a workflow where a DataCollector gathers data, a Reviewer checks it, a Processor transforms it, and a FinalReviewer approves before storage.",
    "template_json": {
      "graph_name": "Data_Pipeline_Review",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "DataCollector",
          "type": "agent",
          "system_prompt": "Collect raw data from sources.",
          "tools": [
            "data_api"
          ],
          "next": "Reviewer"
        },
        {
          "id": "Reviewer",
          "type": "agent",
          "system_prompt": "Review collected data for quality. If not approved, return to DataCollector.",
          "next": "Processor"
        },
        {
          "id": "Processor",
          "type": "agent",
          "system_prompt": "Process and transform data.",
          "tools": [
            "transform_tool"
          ],
          "next": "FinalReviewer"
        },
        {
          "id": "FinalReviewer",
          "type": "agent",
          "system_prompt": "Approve processed data for storage. If not approved, return to Processor.",
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "DataCollector",
          "to": "Reviewer"
        },
        {
          "from": "Reviewer",
          "to": "Processor"
        },
        {
          "from": "Processor",
          "to": "FinalReviewer"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
