  {
    "use_case": "Automated Code Review",
    "description": "A workflow for automated code review and approval using MCP GitHub tools.",
    "sample_prompt": "Create a workflow where a CodeReviewer checks PRs using GitHub MCP tools, a LeadReviewer gives final approval, and a Merger merges the PR if approved.",
    "template_json": {
      "graph_name": "Automated_Code_Review",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "mcp_servers": {
        "github_tools": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-github"
          ]
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "CodeReviewer",
          "type": "agent",
          "system_prompt": "Review pull requests using GitHub MCP tools.",
          "tools": [
            "github_tools"
          ],
          "next": "LeadReviewer"
        },
        {
          "id": "LeadReviewer",
          "type": "agent",
          "system_prompt": "Give final approval for PRs.",
          "tools": [
            "github_tools"
          ],
          "next": "Merger"
        },
        {
          "id": "Merger",
          "type": "agent",
          "system_prompt": "Merge approved PRs.",
          "tools": [
            "github_tools"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "CodeReviewer",
          "to": "LeadReviewer"
        },
        {
          "from": "LeadReviewer",
          "to": "Merger"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
