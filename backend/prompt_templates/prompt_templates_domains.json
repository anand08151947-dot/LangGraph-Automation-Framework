[
  {
    "use_case": "Healthcare Patient Intake",
    "description": "Automated patient intake workflow with triage, doctor assignment, and follow-up.",
    "sample_prompt": "Create a workflow where an IntakeAgent collects patient info, a TriageAgent assesses urgency, a DoctorAgent provides care, and a FollowUpAgent schedules follow-up.",
    "template_json": {
      "graph_name": "Patient_Intake_Flow",
      "version": "1.0",
      "runtime": {
        "max_iterations": 10,
        "checkpoint_store": "sqlite",
        "observability": {
          "tracing": true,
          "provider": "logging"
        }
      },
      "memory": {
        "short_term": {
          "type": "graph_state"
        },
        "long_term": {
          "type": "sqlite",
          "provider": "sqlite",
          "collection": "workflow_memory"
        }
      },
      "state_schema": {
        "input": "string",
        "output": "string",
        "status": "string",
        "retry_count": "integer"
      },
      "nodes": [
        {
          "id": "IntakeAgent",
          "type": "agent",
          "system_prompt": "Collect patient information and symptoms.",
          "tools": [
            "ehr_api"
          ],
          "next": "TriageAgent"
        },
        {
          "id": "TriageAgent",
          "type": "agent",
          "system_prompt": "Assess urgency and assign to appropriate doctor.",
          "tools": [
            "triage_tool"
          ],
          "next": "DoctorAgent"
        },
        {
          "id": "DoctorAgent",
          "type": "agent",
          "system_prompt": "Provide medical care and instructions.",
          "tools": [
            "ehr_api"
          ],
          "next": "FollowUpAgent"
        },
        {
          "id": "FollowUpAgent",
          "type": "agent",
          "system_prompt": "Schedule follow-up appointment and send reminders.",
          "tools": [
            "calendar_api"
          ],
          "next": "END"
        }
      ],
      "edges": [
        {
          "from": "IntakeAgent",
          "to": "TriageAgent"
        },
        {
          "from": "TriageAgent",
          "to": "DoctorAgent"
        },
        {
          "from": "DoctorAgent",
          "to": "FollowUpAgent"
        }
      ],
      "retry_policy": {
        "max_retries": 2,
        "increment_state": "retry_count"
      },
      "checkpointing": {
        "enabled": true,
        "nodes": []
      },
      "observability_hooks": {
        "trace_nodes": true,
        "log_state_transitions": true,
        "capture_agent_outputs": true
      }
    }
  },
