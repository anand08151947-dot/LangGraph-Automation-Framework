# Phoenice Constellation — environment template
# Copy this to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Required: JWT secret for API auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-64-char-hex-string

# LM Studio (local LLM server — default)
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# Optional: OpenAI API key (for GPT models)
# OPENAI_API_KEY=sk-your-key-here

# Optional: Gemini API key
# GEMINI_API_KEY=your-key-here

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=phoenice-constellation

# Optional: LangGraph checkpointing DB path override
# CHECKPOINT_DB=artifacts/langgraph_checkpoints.sqlite

# Optional: Redis (if STM/LTM backend = redis)
# REDIS_URL=redis://localhost:6379
